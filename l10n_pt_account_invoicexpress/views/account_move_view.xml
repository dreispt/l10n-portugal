<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Account Move form view extended -->
    <record model="ir.ui.view" id="view_account_move_form">
        <field name="name">account.move.form.invoicexpress</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account_invoice_api_connector.view_account_move_form" />
        <field name="arch" type="xml">
            <div name="journal_div" position="after">
                <field
                    name="invoicexpress_doc_type"
                    readonly="posted_before"
                    invisible="not can_invoice_api"
                />
            </div>
            <xpath expr="//notebook//page[@name='invoice_api']" position="attributes">
                <attribute name="string">InvoiceXpress</attribute>
            </xpath>
            <button name="action_send_external_invoice_email" position="attributes">
                <attribute name="string">Email InvoiceXpress</attribute>
            </button>
        </field>
    </record>
</odoo>
